{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/filament-passkeys.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx @tailwindcss/cli -i resources/css/index.css -o resources/dist/filament-passkeys.css --minify",
        "build:scripts": "node bin/build.js",
        "purge": "filament-purge -i resources/dist/filament-passkeys.css -o resources/dist/filament-passkeys.css -v 4.x",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*"
    },
    "devDependencies": {
        "@awcodes/filament-plugin-purge": "^1.1.1",
        "@tailwindcss/forms": "^0.5.4",
        "@tailwindcss/typography": "^0.5.9",
        "autoprefixer": "^10.4.14",
        "esbuild": "^0.28.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^2.7.1",
        "prettier-plugin-tailwindcss": "^0.1.13",
        "tailwindcss": "^4.0"
    },
    "dependencies": {
        "@laravel/passkeys": "^0.1.0",
        "@tailwindcss/cli": "^4.1.11"
    }
}
